<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.kunter</groupId>
    <artifactId>dynamic-sql-plus-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>MyBatis Dynamic SQL Plus</name>
    <description>基于注解处理器的 MyBatis Dynamic SQL 代码生成器</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency Versions -->
        <javapoet.version>1.13.0</javapoet.version>
        <mybatis-dynamic-sql.version>2.0.0</mybatis-dynamic-sql.version>
        <mybatis.version>3.5.13</mybatis.version>
    </properties>

    <modules>
        <module>dynamic-sql-plus-annotations</module>
        <module>dynamic-sql-plus-processor</module>
        <module>dynamic-sql-plus-spring-boot-starter</module>
        <module>dynamic-sql-plus-example</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- 项目内部模块 -->
            <dependency>
                <groupId>cn.kunter</groupId>
                <artifactId>dynamic-sql-plus-annotations</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.kunter</groupId>
                <artifactId>dynamic-sql-plus-processor</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 第三方依赖 -->
            <dependency>
                <groupId>com.squareup</groupId>
                <artifactId>javapoet</artifactId>
                <version>${javapoet.version}</version>
            </dependency>

            <!-- MyBatis Dynamic SQL (生成器编译期依赖) -->
            <dependency>
                <groupId>org.mybatis.dynamic-sql</groupId>
                <artifactId>mybatis-dynamic-sql</artifactId>
                <version>${mybatis-dynamic-sql.version}</version>
            </dependency>

            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis</artifactId>
                <version>${mybatis.version}</version>
            </dependency>

            <!-- 测试依赖 -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>5.10.0</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
